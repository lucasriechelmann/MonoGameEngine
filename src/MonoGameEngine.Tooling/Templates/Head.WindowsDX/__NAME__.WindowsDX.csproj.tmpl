<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RollForward>Major</RollForward>
    <PublishReadyToRun>false</PublishReadyToRun>
    <RootNamespace>__ID__</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <!-- Scene files are plain JSON loaded at runtime, so they are copied into the built Content folder. -->
    <None Include="..\content\**\*.scene.json" Exclude="..\content\bin\**;..\content\obj\**"
          Link="Content\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <MonoGameContentReference Include="..\content\Content.mgcb" Link="Content\Content.mgcb" />
    <PackageReference Include="MonoGame.Framework.WindowsDX" Version="__MONOGAME_VERSION__" />
    <PackageReference Include="MonoGame.Content.Builder.Task" Version="__MONOGAME_VERSION__" />
    <ProjectReference Include="..\__NAME__.Core\__NAME__.Core.csproj" />
  </ItemGroup>
</Project>
