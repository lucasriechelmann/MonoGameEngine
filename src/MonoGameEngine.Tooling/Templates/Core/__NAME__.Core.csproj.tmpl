<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>__ID__</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <!-- Compile against MonoGame without passing it on: each platform head brings its own MonoGame package. -->
    <PackageReference Include="MonoGame.Framework.DesktopGL" Version="__MONOGAME_VERSION__" PrivateAssets="all" />
    <PackageReference Include="MonoGameEngine.Engine" Version="__ENGINE_VERSION__" />
  </ItemGroup>
</Project>
