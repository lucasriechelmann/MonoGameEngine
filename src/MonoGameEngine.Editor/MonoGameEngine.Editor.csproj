<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <RollForward>Major</RollForward>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <PublishReadyToRun>false</PublishReadyToRun>
  </PropertyGroup>
  <ItemGroup>
    <!-- Icon font and its license, copied next to the exe. -->
    <None Include="Assets\Fonts\*" Link="Fonts\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="MonoGame.Framework.DesktopGL" Version="$(MonoGameVersion)" />
    <PackageReference Include="ImGui.NET" Version="1.91.6.1" />
    <ProjectReference Include="..\MonoGameEngine.Engine\MonoGameEngine.Engine.csproj" />
    <ProjectReference Include="..\MonoGameEngine.Tooling\MonoGameEngine.Tooling.csproj" />
  </ItemGroup>
</Project>
